<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C6D5C6">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="435dp"
        android:layout_height="56dp"
        android:gravity="center_vertical|space_between"
        android:orientation="horizontal"
        android:padding="12dp">


        <!-- Icono menú -->
        <ImageView
            android:id="@+id/btnLogo"
            android:layout_width="95dp"
            android:layout_height="65dp"
            android:src="@drawable/_a1a008d_b600_4379_9c46_2f07437596a6" />

        <!-- Íconos lado derecho -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <View
                android:layout_width="164dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnUsuario"
                android:layout_width="36dp"
                android:layout_height="33dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/descarga" />

            <ImageView
                android:id="@+id/btnCarrito"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:src="@drawable/descarga__5_" />

            <ImageView
                android:id="@+id/btnNotificaciones"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:src="@drawable/descarga__7_" />
        </LinearLayout>
    </LinearLayout>

    <!-- BARRA DE BÚSQUEDA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#DDE9DE"
        android:gravity="center_vertical">

        <EditText
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background_normal" />
    </LinearLayout>

    <!-- LISTADO DE PRODUCTOS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FILA DE PRODUCTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="12dp">

                <!-- Producto 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="231dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/articulo_290_300x200" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=" Plato Perro Bambu"
                        android:textColor="#000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="S/ 150.00"
                        android:textColor="#007F5F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical|space_between"
                        android:orientation="horizontal">

                        <!-- Botón "-" y cantidad -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnMenos"
                                android:layout_width="40dp"
                                android:layout_height="35dp"
                                android:backgroundTint="#E57373"
                                android:text="-"
                                android:textColor="#FFF"
                                android:textSize="18sp" />

                        </LinearLayout>

                        <!-- Precio y botón "+" al lado derecho -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnMas"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#81C784"
                                android:text="+"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>


                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#447A6F"
                        android:text="Comprar"
                        android:textAllCaps="false"
                        android:textColor="#FFF" />
                </LinearLayout>

                <!-- Producto 2 -->
                <LinearLayout
                    android:layout_width="0dp"

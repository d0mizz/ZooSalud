<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C6D5C6">

    <<!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="435dp"
        android:layout_height="56dp"
        android:gravity="center_vertical|space_between"
        android:orientation="horizontal"
        android:padding="12dp">


        <!-- Icono menú -->
        <ImageView
            android:id="@+id/btnLogo"
            android:layout_width="95dp"
            android:layout_height="65dp"
            android:src="@drawable/_a1a008d_b600_4379_9c46_2f07437596a6" />

        <!-- Íconos lado derecho -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <View
                android:layout_width="164dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnUsuario"
                android:layout_width="36dp"
                android:layout_height="33dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/descarga" />

            <ImageView
                android:id="@+id/btnCarrito"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:src="@drawable/descarga__5_" />

            <ImageView
                android:id="@+id/btnNotificaciones"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:src="@drawable/descarga__7_" />
        </LinearLayout>
    </LinearLayout>
    <!-- BARRA DE BÚSQUEDA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#DDE9DE"
        android:gravity="center_vertical"
        android:padding="8dp">

        <EditText
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Buscar"
            android:padding="10dp" />
    </LinearLayout>


    <!-- LISTADO DE PRODUCTOS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FILA DE PRODUCTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="1dp">

                <!-- Producto 1 -->

                <!-- Producto 2 -->
                <LinearLayout

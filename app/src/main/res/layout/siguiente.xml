<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Logo/Texto GO RPM en la parte superior -->

    <!-- Contenedor principal del contenido -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:text="GO RPM"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Texto instructivo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accede a los signos vitales, historial médico y consejos de salud personalizados tocando la foto de tu mascota y deslizando hacia la derecha para ver todas las estadísticas disponibles"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="40dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"/>

        <!-- Foto de mascota interactiva con indicador de swipe -->
        <RelativeLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/circle_background"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/pet_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_pet_image"/>

            <!-- Indicador de swipe (puede ser una flecha o puntos) -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_swipe_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="8dp"/>
        </RelativeLayout>
    </LinearLayout>

    <!-- Botón SIGUIENTE en la parte inferior -->
    <Button
        android:id="@+id/next_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIGUIENTE"
        android:textAllCaps="true"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button"
        android:layout_marginBottom="24dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:minWidth="160dp"/>

</LinearLayout>